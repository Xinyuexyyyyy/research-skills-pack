# Paper Reading Skill - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# Elsevier API Key (Optional, for fetching abstracts from Elsevier journals)
# Required for: DOI with prefix 10.1016/ (e.g., Fuel, IJHE, Energy, RSER journals)
# How to get: https://dev.elsevier.com/
# Priority: HIGH (100% hit rate for Elsevier papers, as of 2026-05-12)
ELSEVIER_API_KEY=your_elsevier_api_key_here

# Semantic Scholar API Key (Optional, for abstract enrichment)
# Required for: Alternative abstract source when OpenAlex/Crossref fail
# How to get: https://www.semanticscholar.org/product/api
# Note: As of 2026-05-12, application approval has been tightened
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# Study Research Root Directory (Optional, defaults to ~/study-research)
# Used by: tools/abstract_pipeline.py, tools/evidence_extractor.py
STUDY_RESEARCH_ROOT=~/study-research
